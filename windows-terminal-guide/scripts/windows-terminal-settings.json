{
  "$help": "https://aka.ms/terminal-documentation",
  "defaultProfile": "{2ece5bfe-50ed-5f3a-ab87-5cd4baf7934f}",
  "theme": "dark",
  "copyOnSelect": false,
  "copyFormatting": "none",
  "profiles": {
    "defaults": {
      "font": {
        "face": "JetBrainsMono Nerd Font",
        "size": 11
      },
      "colorScheme": "Catppuccin Mocha",
      "opacity": 92,
      "useAcrylic": true,
      "padding": "8",
      "cursorShape": "bar",
      "bellStyle": "none"
    },
    "list": [
      {
        "name": "Git Bash",
        "guid": "{2ece5bfe-50ed-5f3a-ab87-5cd4baf7934f}",
        "commandline": "\"C:/Program Files/Git/bin/bash.exe\" -i -l",
        "startingDirectory": "%USERPROFILE%",
        "icon": "C:/Program Files/Git/mingw64/share/git/git-for-windows.ico"
      },
      {
        "name": "PowerShell",
        "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
        "commandline": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe"
      }
    ]
  },
  "schemes": [
    {
      "name": "Catppuccin Mocha",
      "cursorColor": "#F5E0DC",
      "selectionBackground": "#585B70",
      "background": "#1E1E2E",
      "foreground": "#CDD6F4",
      "black": "#45475A",
      "red": "#F38BA8",
      "green": "#A6E3A1",
      "yellow": "#F9E2AF",
      "blue": "#89B4FA",
      "purple": "#F5C2E7",
      "cyan": "#94E2D5",
      "white": "#BAC2DE",
      "brightBlack": "#585B70",
      "brightRed": "#F38BA8",
      "brightGreen": "#A6E3A1",
      "brightYellow": "#F9E2AF",
      "brightBlue": "#89B4FA",
      "brightPurple": "#F5C2E7",
      "brightCyan": "#94E2D5",
      "brightWhite": "#A6ADC8"
    }
  ],
  "actions": [
    { "keys": "win+`", "command": { "action": "quakeMode" } },
    { "keys": "alt+shift+d", "command": { "action": "splitPane", "split": "auto", "size": 0.5 } },
    { "keys": "alt+shift+-", "command": { "action": "splitPane", "split": "horizontal", "size": 0.5 } },
    { "keys": "alt+shift++", "command": { "action": "splitPane", "split": "vertical", "size": 0.5 } }
  ]
}
